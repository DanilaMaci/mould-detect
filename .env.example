# Copy to .env and fill in. .env is gitignored and must never be committed.
# Used by the server-side jobs in jobs/, never by the firmware.

# House location in decimal degrees, 2 decimals (about 1 km) is enough
LATITUDE=
LONGITUDE=

# Supabase: Project Settings -> API. The SECRET key bypasses row level security: keep it out of firmware and git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# services/monitor (all optional). Alerts go to the ntfy topic: on ntfy.sh anyone who knows the name can read it,
# so use a long random one: python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
NTFY_TOPIC=
# MONITOR_DEVICES=node1
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# MONITOR_HTTP=dashboard=http://localhost:8000/

# services/api: tokens of 16+ characters, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# API_DEVICE_TOKENS=node1=<token>   (device id comes from its token)
API_DEVICE_TOKENS=
API_READ_TOKEN=
# API_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
